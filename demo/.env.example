# Sao chép thành .env. Không commit .env.

NODE_ENV=development

# Database (docker-compose.yml)
DATABASE_URL=postgres://authz:authz@localhost:5433/authz_demo

# App chỉ có 1 tenant; key phải khớp db/0002_seed.sql
TENANT_KEY=nhg-demo

# --- Đăng nhập ---------------------------------------------------------
# dev-mock: IdP giả lập, chọn danh tính từ DEV_MOCK_IDP_FILE. API từ chối khởi động
#           với dev-mock khi NODE_ENV=production.
# oidc:     IdP thật (Entra ID, Google, Keycloak...) qua OpenID Connect.
AUTH_PROVIDER=dev-mock
DEV_MOCK_IDP_FILE=./dev-mock-idp.json

# Chỉ dùng khi AUTH_PROVIDER=oidc
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# OIDC_SCOPES=openid email profile

# --- Session -----------------------------------------------------------
SESSION_COOKIE_NAME=authz_sid
SESSION_TTL_MINUTES=480

# --- URL ---------------------------------------------------------------
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
